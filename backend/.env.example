# Copie para .env (ignorado pelo Git). NUNCA commite valores reais.
# Em NODE_ENV=production, DATABASE_URL, AUTH_SECRET e GAME_SESSION_INTERNAL_SECRET
# sao obrigatorios e os segredos precisam ter >= 32 caracteres.
NODE_ENV=
PORT=
DATABASE_URL=
AUTH_SECRET=
GAME_SESSION_INTERNAL_SECRET=
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
JOIN_TICKET_TTL_SECONDS=
RECONNECT_WINDOW_SECONDS=
MAX_BODY_BYTES=
TRUST_PROXY=
LOG_LEVEL=
# E7.1: IP do cliente e chave por sessao
# TRUST_PROXY e OBRIGATORIO em production (true|false). true so atras de proxy que sobrescreve o cabecalho.
PROXY_IP_HEADER=
TRUSTED_PROXY_HOPS=
# Em production deve ser true (padrao); false e proibido la.
REQUIRE_SESSION_KEY=
# Orcamentos (opcionais; ver docs/E4_SECURITY_REVIEW.md)
CHARACTER_REWARD_XP_PER_WINDOW=
CHARACTER_REWARD_XP_WINDOW_SECONDS=
CHARACTER_STAT_CAP_PERCENT_PER_LEVEL=
