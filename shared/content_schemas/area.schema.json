{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eldervale/area.schema.json",
  "title": "Areas de gatilho (data/areas/<regiao>.json)",
  "description": "Cilindros (raio no plano XZ, altura vertical) usados pelo servidor para o objetivo reach_area. Posicoes de Greenwood sao PLACEHOLDER.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region", "areas"],
  "properties": {
    "schema_version": { "const": 1 },
    "region": { "type": "string" },
    "areas": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "center", "radius"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
          "display_name": { "type": "string" },
          "center": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
          "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
          "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 200, "default": 6 },
          "placeholder": { "type": "boolean" }
        }
      }
    }
  }
}
