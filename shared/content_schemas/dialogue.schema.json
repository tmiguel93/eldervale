{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eldervale/dialogue.schema.json",
  "title": "Dialogo (data/dialogues/<id>.json)",
  "description": "Arvore de dialogo de UM NPC. Validada por scripts/dialogue/dialogue_def.gd. `entries` escolhe o no inicial (primeira condicao verdadeira; a ultima entrada e o fallback sem `if`). No sem `choices` e terminal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "npc_id", "entries", "nodes"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
    "condition": {
      "description": "Exatamente uma forma (quest+state juntos contam como uma). Aninhamento maximo 4.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["quest", "state"], "properties": {
            "quest": { "$ref": "#/$defs/id" },
            "state": { "oneOf": [ { "$ref": "#/$defs/questState" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/questState" } } ] } } },
        { "type": "object", "additionalProperties": false, "required": ["min_level"], "properties": { "min_level": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/condition" } } }
      ]
    },
    "questState": { "enum": ["unavailable", "available", "active", "ready", "completed"] },
    "effect": {
      "type": "object", "additionalProperties": false, "required": ["type", "quest_id"],
      "properties": { "type": { "enum": ["accept_quest", "turn_in_quest"] }, "quest_id": { "$ref": "#/$defs/id" } }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "npc_id": { "$ref": "#/$defs/id" },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "type": "object", "additionalProperties": false, "required": ["node"], "properties": { "if": { "$ref": "#/$defs/condition" }, "node": { "$ref": "#/$defs/id" } } }
    },
    "nodes": {
      "type": "object", "minProperties": 1, "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["speaker", "text", "text_key"],
        "properties": {
          "speaker": { "type": "string", "maxLength": 48 },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "text_key": { "type": "string", "minLength": 1, "maxLength": 96 },
          "on_enter": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/effect" } },
          "choices": {
            "type": "array", "maxItems": 6,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["text", "text_key", "next"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 160 },
                "text_key": { "type": "string", "minLength": 1, "maxLength": 96 },
                "if": { "$ref": "#/$defs/condition" },
                "effects": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/effect" } },
                "next": { "oneOf": [ { "$ref": "#/$defs/id" }, { "type": "null" } ], "description": "null encerra o dialogo" }
              }
            }
          }
        }
      }
    }
  }
}
